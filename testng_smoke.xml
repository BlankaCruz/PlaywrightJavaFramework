<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >

<!--<suite name = "TestSuite" parallel = "methods" thread-count="3">-->
<!--<suite name = "TestSuite" parallel = "tests">-->
<!--recommended...-->
<suite name = "TestSuite" verbose="1" parallel = "classes" thread-count="3">

    <groups>
        <run>
            <include name="smoke" />
        </run>
    </groups>

    <test name = "RegressionTests">
        <classes>
            <class name = "tests.FrameworkBuildDataDrivenTest" />
            <class name = "tests.MoreUIValidationsTest" />
            <class name = "tests.UIValidationsContinuedTest" />
            <class name = "tests.MockWebTest" />
        </classes>
    </test>

    <test name = "SmokeTests">
        <classes>
            <class name = "tests.BasicsTest" />
        </classes>
    </test>
</suite>